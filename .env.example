# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - ELEMENTARY MATH UI
# Lưu ý: Các biến dùng trong code React Native / Expo BẮT BUỘC có tiền tố EXPO_PUBLIC_
# ==========================================

# URL backend API cho môi trường hiện tại. Cấu hình host và port tại đây.

# URL Backend API:
# - Chạy web / iOS simulator: http://localhost:6001/api
# - Chạy Android emulator: http://10.0.2.2:6001/api
# - Chạy điện thoại thật qua Expo Go: thay localhost bằng IP máy tính (VD: http://192.168.1.15:6001/api)
EXPO_PUBLIC_API_URL=

# Thời gian chờ tối đa cho mỗi request API (milliseconds)
EXPO_PUBLIC_API_TIMEOUT=
