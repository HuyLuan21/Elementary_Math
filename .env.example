# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - ELEMENTARY MATH UI
# Lưu ý: Các biến dùng trong code React Native / Expo BẮT BUỘC có tiền tố EXPO_PUBLIC_
# ==========================================

# 1. URL Backend API
# - Web / iOS Simulator: http://localhost:6001/api
# - Android Emulator:    http://10.0.2.2:6001/api
# - Điện thoại thật (Expo Go): http://<IP_LAN_MAY_TINH>:6001/api (Ví dụ: http://192.168.1.5:6001/api)
# Nếu để trống, hệ thống sẽ tự động phát hiện IP máy chủ theo nền tảng đang chạy.
EXPO_PUBLIC_API_URL=


# 3. Thời gian chờ tối đa cho mỗi request API (milliseconds)
EXPO_PUBLIC_API_TIMEOUT=
