# URL Backend API: Để trống để App tự động dò tìm IP máy tính của bạn khi chạy trên điện thoại chung Wi-Fi
# Hoặc điền trực tiếp IP máy tính của bạn (VD: http://192.168.1.15:6001/api)
# EXPO_PUBLIC_API_URL=http://localhost:6001/api

# Thời gian chờ tối đa cho mỗi request API (ms)
EXPO_PUBLIC_API_TIMEOUT=15000
